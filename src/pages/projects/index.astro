---
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<Base
  title="Projects"
  description="Interactive maps and visualizations by Steven Fazzio: datamaps of large text collections and other projects."
>
  <h1>Projects</h1>
  <p class="lede">
    Interactive artifacts, mostly maps of large text collections. Each one gets a blog post telling
    its story; the write-up links are filled in as posts are published.
  </p>
  <ul class="projects">
    {
      projects.map(({ data }, i) => (
        <li class="project">
          <a href={data.url} class="shot" tabindex="-1" aria-hidden="true">
            {data.thumbnail ? (
              <img
                src={data.thumbnail}
                alt=""
                width="1200"
                height="750"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ) : (
              <span class="shot-fallback" />
            )}
          </a>
          <div class="meta">
            <h2 class="project-name">
              <a href={data.url}>{data.name}</a>
            </h2>
            <p class="one-liner">{data.oneLiner}</p>
            {data.post && (
              <p class="write-up">
                <a href={data.post}>Read the write-up →</a>
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .lede {
    color: var(--muted);
    max-width: 44rem;
    margin-bottom: var(--space-4);
  }

  /* Breaks out of the page measure so the thumbnails get room, without
     widening <body> -- that would move the right-aligned nav links between
     this page and every other one. Centred on the viewport, clamped so it
     never introduces horizontal scroll. */
  .projects {
    --grid-w: min(var(--measure-wide), calc(100vw - 3rem));
    width: var(--grid-w);
    margin-inline: calc((100% - var(--grid-w)) / 2);
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-4) var(--space-3);
  }

  .project {
    display: flex;
    flex-direction: column;
  }

  .shot {
    display: block;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface);
    line-height: 0;
    transition:
      border-color 120ms ease,
      transform 120ms ease;
  }
  .shot img,
  .shot-fallback {
    display: block;
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
  }
  .shot-fallback {
    background: linear-gradient(135deg, var(--border), var(--surface));
  }

  .project:hover .shot,
  .project:focus-within .shot {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .meta {
    padding-top: var(--space-2);
  }

  .project-name {
    font-size: var(--step-1);
    line-height: 1.25;
    margin: 0;
  }
  .project-name a {
    color: inherit;
    text-decoration: none;
  }
  .project-name a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .one-liner {
    margin: var(--space-1) 0 0;
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .write-up {
    margin: var(--space-2) 0 0;
    font-size: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .shot {
      transition: none;
    }
    .project:hover .shot,
    .project:focus-within .shot {
      transform: none;
    }
  }
</style>
