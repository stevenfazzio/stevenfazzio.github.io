---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getFeaturedProjects } from '../lib/projects';
import { ONE_LINER, ONE_LINER_GLOSS, AUTHOR, SITE_URL, PROFILES, CONTACT_EMAIL } from '../consts';

const featured = await getFeaturedProjects();

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const recent = posts.slice(0, 5);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR,
  url: SITE_URL,
  description: ONE_LINER,
  email: `mailto:${CONTACT_EMAIL}`,
  sameAs: PROFILES,
};
---

<Base jsonLd={jsonLd}>
  <h1>{ONE_LINER}</h1>
  <p class="gloss">{ONE_LINER_GLOSS}</p>

  <section>
    <h2>Featured projects</h2>
    <ul class="featured">
      {
        featured.map(({ data }, i) => (
          <li>
            <a href={data.url} class="shot" tabindex="-1" aria-hidden="true">
              {data.thumbnail && (
                <img
                  src={data.thumbnail}
                  alt=""
                  width="1200"
                  height="750"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              )}
            </a>
            <div class="meta">
              <h3>
                <a href={data.url}>{data.name}</a>
              </h3>
              <p>{data.oneLiner}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/projects/">All projects →</a></p>
  </section>

  {
    recent.length > 0 && (
      <section>
        <h2>Recent posts</h2>
        <ul class="post-list">
          {recent.map((post) => (
            <li>
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              <span class="post-date">
                {post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                  timeZone: 'UTC',
                })}
              </span>
            </li>
          ))}
        </ul>
        <p class="more">
          <a href="/posts/">All posts →</a>
        </p>
      </section>
    )
  }
</Base>

<style>
  .gloss {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
    max-width: 36rem;
  }

  .featured {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .featured li {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .shot {
    display: block;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface);
    line-height: 0;
    transition:
      border-color 120ms ease,
      transform 120ms ease;
  }
  .shot img {
    display: block;
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
  }
  .featured li:hover .shot,
  .featured li:focus-within .shot {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .meta h3 {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .meta h3 a {
    color: inherit;
    text-decoration: none;
  }
  .meta h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .meta p {
    margin: var(--space-1) 0 0;
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .more {
    margin-top: var(--space-3);
    font-size: 0.95rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-list li {
    margin-bottom: var(--space-2);
  }
  .post-date {
    color: var(--muted);
    font-size: 0.85rem;
    margin-left: var(--space-2);
  }

  @media (max-width: 34rem) {
    .featured li {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot {
      transition: none;
    }
    .featured li:hover .shot,
    .featured li:focus-within .shot {
      transform: none;
    }
  }
</style>
