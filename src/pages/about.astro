---
import Base from '../layouts/Base.astro';
import { AUTHOR, SITE_URL, GITHUB_URL, LINKEDIN_URL, PROFILES, CONTACT_EMAIL } from '../consts';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR,
  url: SITE_URL,
  description: 'Data scientist making interactive maps of large text collections.',
  email: `mailto:${CONTACT_EMAIL}`,
  sameAs: PROFILES,
};
---

<Base title="About" description="Who Steven Fazzio is and what he does." jsonLd={jsonLd}>
  <h1>About</h1>
  <p>
    I'm Steven Fazzio. I make interactive maps of large text collections: embed a corpus, lay it
    out in two dimensions, and name the regions. The <a href="/projects/">projects page</a> has all
    of them.
  </p>
  <p>
    I work on <a href="https://github.com/TutteInstitute/datamapplot">DataMapPlot</a> and
    <a href="https://github.com/TutteInstitute/toponymy">Toponymy</a>.
  </p>
  <p>
    The interactive artifacts live at subpaths of this domain. There's an
    <a href="/rss.xml">RSS feed</a>.
  </p>
  <p>
    I'm available for consulting through Fazzio Consulting. If you have a large pile of text and
    questions about what's inside it, <a href={`mailto:${CONTACT_EMAIL}`}>get in touch</a>.
  </p>
  <p>
    You can also find me on <a rel="me" href={GITHUB_URL}>GitHub</a> and
    <a rel="me" href={LINKEDIN_URL}>LinkedIn</a>.
  </p>
</Base>
